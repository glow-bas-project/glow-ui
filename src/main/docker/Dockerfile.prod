####
# This Dockerfile is used in order to build a container that runs the glow-ui application in production mode.
#
# Before building the container image run:
#
# npm ci
# npm run build
#
# Then, build the image with:
#
# docker build -f src/main/docker/Dockerfile.prod -t glow-ui .
#
# Then run the container using:
#
# docker run -i --rm -p 80:80 glow-ui
#
# This image uses nginx to serve the static Vite build at /
#
####
FROM node:22-alpine AS build

WORKDIR /app

ARG VITE_APP_URL
ARG VITE_KEYCLOAK_URL
ARG VITE_KEYCLOAK_REALM
ARG VITE_KEYCLOAK_CLIENT_ID

ENV VITE_APP_URL=${VITE_APP_URL}
ENV VITE_KEYCLOAK_URL=${VITE_KEYCLOAK_URL}
ENV VITE_KEYCLOAK_REALM=${VITE_KEYCLOAK_REALM}
ENV VITE_KEYCLOAK_CLIENT_ID=${VITE_KEYCLOAK_CLIENT_ID}

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:1.29-alpine

RUN cat > /etc/nginx/conf.d/default.conf <<'EOF'
server {
	listen 80;
	server_name _;
	root /usr/share/nginx/html;
	index index.html;

	location / {
		try_files $uri $uri/ /index.html;
	}
}
EOF

COPY --from=build /app/dist/ /usr/share/nginx/html/

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
