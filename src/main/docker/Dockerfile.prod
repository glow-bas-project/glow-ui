####
# Production image for glow-ui (nginx + static Vite build).
#
# Auth URLs are configured at container start via GLOW_* env vars (see docker-entrypoint.sh),
# not at npm build time — one image works for compose, k3d, staging, and production.
#
# docker build -f src/main/docker/Dockerfile.prod -t glow-ui .
# docker run --rm -p 8080:80 \
#   -e GLOW_APP_URL=http://localhost:8880 \
#   -e GLOW_KEYCLOAK_URL=http://localhost:8880/auth \
#   glow-ui
####
FROM node:22-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:1.29-alpine

RUN cat > /etc/nginx/conf.d/default.conf <<'EOF'
server {
	listen 80;
	server_name _;
	root /usr/share/nginx/html;
	index index.html;

	location / {
		try_files $uri $uri/ /index.html;
	}
}
EOF

COPY --from=build /app/dist/ /usr/share/nginx/html/
COPY src/main/docker/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

EXPOSE 80

ENTRYPOINT ["/docker-entrypoint.sh"]
